  "roles": [
    {
      "id": "orchestrator",
      "name": "总指挥",
      "duty": "任务调度",
      "detail": "任务调度、依赖管理、状态追踪、冲突协调",
      "outputs": "任务图、执行状态"
    },
    {
      "id": "product",
      "name": "产品",
      "duty": "需求与规划",
      "detail": "需求分析、功能定义、优先级",
      "outputs": "PRD、验收标准"
    },
    {
      "id": "architect",
      "name": "架构师",
      "duty": "系统架构",
      "detail": "架构设计、技术选型、模块拆分",
      "outputs": "设计文档、接口规范"
    },
    {
      "id": "designer",
      "name": "设计师",
      "duty": "交互与视觉",
      "detail": "用户体验、交互、视觉",
      "outputs": "界面规范、页面原型"
    },
    {
      "id": "developer",
      "name": "开发",
      "duty": "编码与实现",
      "detail": "编码、功能、缺陷修复",
      "outputs": "提交、模块"
    },
    {
      "id": "reviewer",
      "name": "审查",
      "duty": "独立审查",
      "detail": "代码与质量审查",
      "outputs": "审查意见、风险报告"
    },
    {
      "id": "qa",
      "name": "测试",
      "duty": "测试验证",
      "detail": "测试用例、自动化、回归、截图验收",
      "outputs": "测试报告"
    },
    {
      "id": "researcher",
      "name": "研究",
      "duty": "技术研究",
      "detail": "调研、方案比较、检索",
      "outputs": "研究报告"
    },
    {
      "id": "devops",
      "name": "运维",
      "duty": "构建与交付",
      "detail": "构建、环境、部署、回滚",
      "outputs": "构建产物、部署报告"
    },
    {
      "id": "security",
      "name": "安全",
      "duty": "安全与权限",
      "detail": "权限、依赖漏洞、安全审计",
      "outputs": "安全报告"
    }
  ],
