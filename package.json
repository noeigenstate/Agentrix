{
  "name": "agentrix",
  "productName": "Agentrix",
  "version": "1.3.12",
  "description": "面向未来的 AI 编辑器：任何 AI 编程命令行工具都能接入，多个项目并排开工，对话排成可读的文档，完成即提醒。",
  "author": "Agentrix",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/noeigenstate/Agentrix.git"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "desktopName": "agentrix.desktop",
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "node scripts/start.mjs --dev",
    "build": "node scripts/build-ssh-askpass.cjs && tsc --noEmit && vite build",
    "test": "node scripts/build-ssh-askpass.cjs && node --test tests/*.test.cjs",
    "audit:design": "node scripts/design-audit.mjs",
    "clean:test-output": "node scripts/clean-test-output.mjs",
    "test:desktop": "node scripts/smoke.mjs",
    "test:sessions": "node scripts/session-smoke.mjs",
    "test:restore-slow": "node scripts/restore-slow-smoke.mjs",
    "test:workspace": "node scripts/workspace-smoke.mjs",
    "test:motion": "node scripts/focus-motion-smoke.mjs",
    "test:completion": "node scripts/completion-smoke.mjs",
    "test:gpu-terminal": "node scripts/gpu-terminal-smoke.mjs",
    "test:editor-terminals": "node scripts/editor-terminals-smoke.mjs",
    "test:themes-markdown": "node scripts/themes-markdown-smoke.mjs",
    "test:glass-transparency": "node scripts/glass-transparency-smoke.mjs",
    "test:desktop-glass": "node scripts/desktop-glass-smoke.mjs",
    "test:visual": "node scripts/visual-smoke.mjs",
    "test:navigation": "node scripts/navigation-smoke.mjs",
    "test:clipboard": "node scripts/clipboard-smoke.mjs",
    "test:material": "node scripts/material-smoke.mjs",
    "test:composer": "node scripts/composer-smoke.mjs",
    "test:reading": "node scripts/reading-smoke.mjs",
    "test:reading-focus": "node scripts/reading-focus-smoke.mjs --startup",
    "test:path-refresh": "node scripts/path-refresh-smoke.mjs",
    "test:git": "node scripts/git-smoke.mjs",
    "test:cmd": "node scripts/cmd-smoke.mjs",
    "dist": "node -e \"require('electron')\" && npm run build && electron-builder --win --x64 --publish never",
    "pack": "node -e \"require('electron')\" && npm run build && electron-builder --win --dir --x64",
    "dist:mac": "node -e \"require('electron')\" && npm run build && electron-builder --mac --arm64 --publish never",
    "pack:mac": "node -e \"require('electron')\" && npm run build && electron-builder --mac dir --arm64",
    "dist:linux": "node -e \"require('electron')\" && npm run build && electron-builder --linux --publish never",
    "pack:linux": "node -e \"require('electron')\" && npm run build && electron-builder --linux dir",
    "test:readability": "node scripts/readability-smoke.mjs",
    "test:appearance": "node scripts/appearance-smoke.mjs",
    "test:question-appearance": "node scripts/question-appearance-smoke.mjs"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "jsonc-parser": "3.3.1",
    "node-pty": "1.2.0-beta.15",
    "sherpa-onnx-node": "1.13.8",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "latest",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "dompurify": "3.4.15",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "marked": "18.0.13",
    "playwright-core": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ssh2": "1.17.0",
    "typescript": "^5.9.3",
    "vite": "8.3.0"
  },
  "build": {
    "appId": "local.projectgrid.desktop",
    "productName": "Agentrix",
    "directories": {
      "output": "release"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE",
      "!**/*.map",
      "!node_modules/node-pty/{src,third_party,scripts,typings,build}/**/*",
      "!node_modules/node-pty/lib/*.test.js",
      "!node_modules/node-pty/binding.gyp",
      "!node_modules/node-pty/prebuilds/!(${platform}-${arch})/**/*",
      "!node_modules/node-pty/prebuilds/*/*.pdb",
      "!node_modules/node-addon-api/**/*",
      "!**/node_modules/sherpa-onnx-!(node)/**/*",
      "!node_modules/jsonc-parser/lib/esm/**/*",
      "!node_modules/js-yaml/{dist,bin}/**/*",
      "!node_modules/argparse/**/*"
    ],
    "extraResources": [
      {
        "from": "integration",
        "to": "integration",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/*.cs"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "noeigenstate",
        "repo": "Agentrix"
      }
    ],
    "nsis": {
      "artifactName": "Agentrix-Setup-${version}-x64.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Agentrix",
      "deleteAppDataOnUninstall": false
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false,
      "artifactName": "Agentrix-${version}-win-x64.${ext}",
      "electronLanguages": [
        "zh-CN",
        "en-US"
      ]
    },
    "mac": {
      "icon": "assets/icon-mac.png",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "minimumSystemVersion": "12.0",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Agentrix 用麦克风做本地语音输入，声音只在这台 Mac 上识别。Agentrix uses the microphone for offline voice input; audio never leaves this Mac."
      },
      "electronLanguages": [
        "zh_CN",
        "en"
      ],
      "artifactName": "Agentrix-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "Agentrix ${version}",
      "artifactName": "Agentrix-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Development",
      "executableName": "agentrix",
      "syncDesktopName": true,
      "synopsis": "Many projects, many real terminals, Codex completion at a glance",
      "target": [
        {
          "target": "AppImage"
        },
        {
          "target": "tar.xz"
        }
      ],
      "electronLanguages": [
        "zh-CN",
        "en-US"
      ],
      "artifactName": "Agentrix-${version}-linux-${arch}.${ext}"
    },
    "toolsets": {
      "appimage": "1.0.3"
    },
    "compression": "maximum",
    "afterPack": "scripts/after-pack.cjs"
  },
  "allowScripts": {
    "electron@44.3.0": true,
    "node-pty@1.2.0-beta.15": true,
    "ssh2@1.17.0": true
  }
}
